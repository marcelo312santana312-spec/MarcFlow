// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  OWNER
  STAFF
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(OWNER)
  ownerId   String?
  apiKey    String?  @unique // API Key for authentication
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sessions  Session[]
  webhooks  Webhook[]
  notifications Notification[]
  owner           User?                  @relation("TeamMembers", fields: [ownerId], references: [id], onDelete: SetNull)
  teamMembers     User[]                 @relation("TeamMembers")
  subscription    Subscription?
  pipelines       Pipeline[]
  products        Product[]
  appointments    Appointment[]
  assignedTickets ConversationTicket[]
  sessionAccesses SessionAccess[]
  instagramAccounts InstagramAccount[]
  instagramPosts    InstagramPost[]
  instagramAccessRequests InstagramAccessRequest[]
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  name        String    // e.g. "Marketing WA"
  sessionId   String    @unique // The unique ID used for Baileys auth
  status      String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ZOMBIE
  qr          String?   @db.Text
  config      Json?     // Store instance specific config (e.g. "read_receipts": true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  messages    Message[]
  groups      Group[]
  autoReplies AutoReply[]
  stories     Story[]
  scheduledMessages ScheduledMessage[]
  webhooks    Webhook[]
  botConfig   BotConfig?
  sessionAccesses SessionAccess[]
  flows       Flow[]
  archiveChats ArchiveChat[]
  deals       Deal[]
  tickets     ConversationTicket[]
  appointments Appointment[]
}

model Contact {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // remoteJid (123456@s.whatsapp.net)
  lid         String?  // LID JID
  name        String?
  notify      String?  // Pushname
  verifiedName String? // Business Name
  remoteJidAlt String? // Alternate JID (e.g. Phone if JID is LID)
  profilePic  String?  @db.Text
  data        Json?    // Detailed contact data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([sessionId, jid])
}

model Message {
  id          String        @id @default(cuid())
  sessionId   String
  remoteJid   String        // Receiver or Group Jid
  senderJid   String?       // If group, who sent it. If private, same as remoteJid (incoming) or me (outgoing)
  fromMe      Boolean
  keyId       String        // WhatsApp Message Key ID
  pushName    String?
  type        MessageType   @default(TEXT)
  content     String?       @db.Text // Text content or Caption
  mediaUrl    String?       @db.Text // Path to file if media
  status      MessageStatus @default(PENDING)
  timestamp   DateTime      @default(now())
  
  quoteId     String?       // For replies
  
  contactId   String?
  contract    Contact?      @relation(fields: [contactId], references: [id])
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, keyId])
  @@index([sessionId, remoteJid])
  @@index([sessionId, remoteJid, timestamp])
}

model Group {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  subject     String?
  description String?  @db.Text
  ownerJid    String?
  participants Json?   // Stored as JSON for now: [{id: '123@s.whatsapp.net', admin: 'admin' | null}]
  creation    DateTime?
  restrict    Boolean? // Only admins can edit group info
  announce    Boolean? // Only admins can send messages
  
  metadata    Json?    // Raw full metadata dump
  
  inviteCode  String?
  
  // Community Features
  isCommunity Boolean  @default(false)
  linkedParentJid String? // JID of the community parent group if it belongs to one
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
}

model AutoReply {
  id          String   @id @default(cuid())
  sessionId   String
  keyword     String
  matchType   String   // EXACT, CONTAINS, REGEX
  response    String?  @db.Text
  isMedia     Boolean  @default(false)
  mediaUrl    String?
  mediaType   String?
  triggerType String   @default("ALL") // ALL, GROUP, PRIVATE
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Story {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // User who posted the story or Broadcast JID
  content     String?  @db.Text
  mediaUrl    String?  @db.Text
  type        String   // IMAGE, VIDEO, TEXT
  timestamp   DateTime @default(now())
  viewed      Boolean  @default(false)

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ScheduledMessage {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  content     String?  @db.Text
  mediaUrl    String?
  mediaType   String?  // image, video, document, etc.
  sendAt      DateTime
  cronExpression String? // e.g., '*/5 * * * *'
  recurrenceRule String? @db.Text // UI JSON state
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  groupId     String?
  notifyJid   String?
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Store for Baileys MultiFileAuthState (in DB)
model AuthState {
  id        String   @id @default(cuid())
  sessionId String
  key       String   // Filename/Key (creds.json, etc)
  value     Json
  
  @@unique([sessionId, key])
}

// Webhook configuration for external event notifications
model Webhook {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String?  // Optional: specific session, null = all sessions
  name        String   // e.g. "My Server Webhook"
  url         String   // The webhook endpoint URL
  secret      String?  // Optional secret for HMAC signing
  events      Json     // Array of event types: ["message.received", "message.sent", "connection.update", etc.]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  logs        WebhookLog[]
}

// Webhook delivery logs â€” tracks every webhook request attempt
model WebhookLog {
  id                 String   @id @default(cuid())
  webhookId          String
  event              String   // The event that triggered this webhook
  status             String   // SUCCESS, FAILED
  requestUrl         String   @db.Text
  requestHeaders     Json?
  requestBody        Json?
  responseStatusCode Int?
  responseBody       String?  @db.Text
  responseTimeMs     Int?
  errorMessage       String?  @db.Text
  createdAt          DateTime @default(now())

  webhook            Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, createdAt])
}

enum AccessMode {
  ALL
  OWNER
  SPECIFIC
  BLACKLIST
}

model BotConfig {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  enabled       Boolean  @default(true)
  
  // Bot Command Access
  botName       String   @default("MarcFlow Bot")
  botMode       AccessMode @default(OWNER)
  botAllowedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"]
  botBlockedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"] for BLACKLIST mode

  // Auto Reply Access
  autoReplyMode AccessMode @default(ALL)
  autoReplyAllowedJids Json?
  autoReplyBlockedJids Json? // Array of JIDs for BLACKLIST mode

  enableSticker Boolean  @default(true)
  enableVideoSticker Boolean @default(true)
  maxStickerDuration Int @default(10) // in seconds
  enablePing    Boolean  @default(true)
  enableUptime  Boolean  @default(true)
  removeBgApiKey String?
  prefix        String   @default("#")
  
  // Anti-Spam / Rate Limit
  antiSpamEnabled Boolean @default(false)
  spamLimit       Int     @default(5)    // Messages allowed in window
  spamInterval    Int     @default(10)   // Seconds window
  spamDelayMin    Int     @default(1000) // MS min delay
  spamDelayMax    Int     @default(3000) // MS max delay

  // Automation & Presence
  welcomeMessage  String? @db.Text
  autoRead        Boolean @default(false)
  alwaysOnline    Boolean @default(false)

  // AI Configuration
  aiEnabled       Boolean @default(false)
  aiApiKey        String?
  aiModel         String?
  aiSystemPrompt  String? @db.Text
  aiTriggerType   String?
  aiContextLimit  Int?    @default(10)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id                 String   @id @default("default") // Singleton ID
  appName            String   @default("MarcFlow")
  logoUrl            String?
  faviconUrl         String?
  timezone           String   @default("America/Sao_Paulo")
  enableRegistration Boolean  @default(true)
  
  updatedAt          DateTime @updatedAt
}

// Labels/Tags for organizing chats
model Label {
  id          String      @id @default(cuid())
  sessionId   String
  name        String
  color       Int         @default(0) // 0-19 for WhatsApp color codes
  colorHex    String      @default("#FF0000") // Hex representation
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  chatLabels  ChatLabel[]
  
  @@unique([sessionId, name]) // Unique label name per session
  @@index([sessionId])
}

// Many-to-many relationship between chats and labels
model ChatLabel {
  id        String   @id @default(cuid())
  labelId   String
  chatJid   String   // The JID of the chat
  createdAt DateTime @default(now())
  
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  
  @@unique([labelId, chatJid]) // Prevent duplicate label assignments
  @@index([chatJid])
  @@index([labelId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, SYSTEM
  read      Boolean  @default(false)
  href      String?
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Shared session access â€” allows session owners to grant access to other users
model SessionAccess {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}

// Broadcast/Blast history & logs
model BroadcastLog {
  id          String              @id @default(cuid())
  sessionId   String              // WA session ID string
  message     String              @db.Text
  total       Int
  sent        Int                 @default(0)
  failed      Int                 @default(0)
  status      String              @default("running") // scheduled, running, paused, completed, cancelled
  delay       Int                 @default(2000)
  name        String?             // campaign name
  mediaAssetId String?            // optional attachment (FlowAsset id)
  pauseOnFailure Boolean          @default(false)
  skipOptedOut   Boolean          @default(true)
  scheduledAt DateTime?
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  recipients  BroadcastRecipient[]

  @@index([sessionId])
  @@index([sessionId, startedAt])
}

model BroadcastRecipient {
  id              String       @id @default(cuid())
  broadcastLogId  String
  jid             String
  status          String       @default("pending") // pending, sent, failed, skipped
  error           String?      @db.Text
  sentAt          DateTime?

  broadcastLog    BroadcastLog @relation(fields: [broadcastLogId], references: [id], onDelete: Cascade)

  @@index([broadcastLogId])
}

// ==============================================
// Conversation flow builder
// ==============================================

enum FlowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum FlowRunStatus {
  RUNNING
  WAITING_INPUT
  WAITING_DELAY
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

model Flow {
  id               String     @id @default(cuid())
  sessionId        String     // Session.id (cuid)
  name             String
  status           FlowStatus @default(DRAFT)
  draftGraph       Json
  draftRevision    Int        @default(0)
  publishedGraph   Json?
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  session          Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggers         FlowTrigger[]
  runs             FlowRun[]

  @@index([sessionId])
}

model FlowTrigger {
  id        String  @id @default(cuid())
  flowId    String
  type      String  // KEYWORD | FIRST_MESSAGE | ANY_MESSAGE
  keyword   String?
  matchType String? // EXACT | CONTAINS | REGEX
  priority  Int     @default(0)

  flow      Flow    @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
}

model FlowRun {
  id            String        @id @default(cuid())
  flowId        String
  sessionId     String        // Session.id (cuid)
  contactJid    String
  status        FlowRunStatus @default(RUNNING)
  graph         Json          // snapshot: edits never change a conversation in progress
  isTest        Boolean       @default(false)
  currentNodeId String?
  wait          Json?
  resumeAt      DateTime?
  stepCount     Int           @default(0)
  lastKeyId     String?
  error         String?       @db.Text
  startedAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  flow          Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  logs          FlowRunLog[]

  @@index([sessionId, contactJid, status])
  @@index([status, resumeAt])
  @@index([flowId, startedAt])
}

model FlowRunLog {
  id        String   @id @default(cuid())
  runId     String
  nodeId    String?
  event     String   // ENTER | SEND | WAIT | INPUT | INVALID | BRANCH | ACTION | ERROR | END
  detail    Json?
  createdAt DateTime @default(now())

  run       FlowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model FlowNodeStat {
  flowId String
  nodeId String
  key    String // "sent", "option:<id>", "seq"
  count  Int    @default(0)

  @@id([flowId, nodeId, key])
}

model FieldDefinition {
  id          String   @id @default(cuid())
  sessionId   String   // Session.id (cuid)
  key         String
  label       String
  type        String   // TEXT | NUMBER | DATE | DATETIME
  scope       String   // CONTACT | BOT
  description String?
  createdAt   DateTime @default(now())

  @@unique([sessionId, scope, key])
}

model BotVariable {
  sessionId String
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@id([sessionId, key])
}

model FlowAsset {
  id           String   @id @default(cuid())
  sessionId    String   // Session.id (cuid)
  path         String
  mime         String
  size         Int
  originalName String
  createdAt    DateTime @default(now())

  @@index([sessionId])
}

// Per-contact flow data. Kept apart from Contact.data because contact sync overwrites that column.
model ContactFlowData {
  sessionId         String    // Session.id (cuid)
  contactJid        String
  fields            Json?     // { [fieldKey]: string }
  pausedUntil       DateTime? // automations paused (triggers + auto-reply)
  autoReplyOffUntil DateTime? // only auto-reply silenced
  updatedAt         DateTime  @updatedAt

  @@id([sessionId, contactJid])
}

// Unread counter per chat (kept in sync with WhatsApp read events)
model ChatState {
  sessionId   String   // Session.id (cuid)
  jid         String
  unreadCount Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([sessionId, jid])
}

// Quick replies ("raio" in the chat composer): a titled sequence of actions sent to the open chat
model QuickReply {
  id         String   @id @default(cuid())
  sessionId  String   // Session.id (cuid)
  title      String
  categoryId String?
  actions    Json     // QuickReplyAction[] (see src/modules/quick-replies/types.ts)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   QuickReplyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

model QuickReplyCategory {
  id        String   @id @default(cuid())
  sessionId String   // Session.id (cuid)
  name      String
  color     String   @default("#25D366")
  createdAt DateTime @default(now())

  replies   QuickReply[]

  @@unique([sessionId, name])
}

// Internal MarcFlow organization of groups; never changes anything on WhatsApp
model GroupCategory {
  id        String   @id @default(cuid())
  sessionId String   // Session.id (cuid)
  name      String
  nameKey   String   // lower-case, single-spaced name: makes "Trabalho" and " trabalho " the same
  color     String   @default("#10B981")
  icon      String?  // key of the icon list in src/modules/groups/categories.ts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links     GroupCategoryLink[]

  @@unique([sessionId, nameKey])
}

// Kept apart from Group: group rows are rewritten on every WhatsApp sync, the category must survive it
model GroupCategoryLink {
  sessionId  String   // Session.id (cuid)
  groupJid   String   // stable group id (...@g.us), never the name
  categoryId String
  updatedAt  DateTime @updatedAt

  category   GroupCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([sessionId, groupJid])
  @@index([categoryId])
}

// Saved, unsent broadcast form ("Rascunhos")
model BroadcastDraft {
  id             String    @id @default(cuid())
  sessionId      String    // WA session id string, like BroadcastLog
  name           String    @default("")
  message        String    @db.Text
  recipients     Json      // string[] of jids
  mediaAssetId   String?
  intervalMs     Int       @default(10000)
  pauseOnFailure Boolean   @default(false)
  skipOptedOut   Boolean   @default(true)
  scheduledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([sessionId])
}

// Contacts that asked not to receive broadcasts; skipped when "Excluir contatos descadastrados" is on
model BroadcastOptOut {
  sessionId String   // WA session id string
  jid       String
  createdAt DateTime @default(now())

  @@id([sessionId, jid])
}

// "Exportar conversas": saved history of one WhatsApp account, ready to export (ZIP with TXT + audio).
// Files live in data/archive/<Session.id>/<chat folder>/; one job at a time per session.
model ArchiveJob {
  id           String    @id @default(cuid())
  userId       String
  sessionId    String    // Session.id (cuid)
  accountJid   String?   // WhatsApp account the history came from
  status       String    @default("running") // running | paused | completed | completed_with_errors | cancelled
  phase        String    @default("scan")    // scan | backfill | media | done
  includeMedia Boolean   @default(false)     // photos, videos, documents and stickers (audio is always included)
  chatJids     Json?     // selected chats (string[]); null = every chat of the session
  cursor       Json?     // resume state of the local scan
  note         String?   @db.Text            // why it paused / last warning
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([sessionId, createdAt])
}

model ArchiveChat {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String   // Session.id (cuid)
  jid           String
  name          String?
  isGroup       Boolean  @default(false)
  folder        String   // stable folder name: <name>__<number>
  backfillDone  Boolean  @default(false) // no older messages left to request from the phone
  backfillNote  String?  @db.Text
  backfillError String?  @db.Text
  createdAt     DateTime @default(now())

  session  Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages ArchiveMessage[]

  @@unique([sessionId, jid])
  @@index([sessionId, backfillDone])
}

model ArchiveMessage {
  id         String   @id @default(cuid())
  chatId     String
  sessionId  String   // Session.id (cuid)
  keyId      String   // WhatsApp message id: makes re-imports idempotent
  fromMe     Boolean
  senderJid  String?
  senderName String?
  type       String   @default("TEXT") // TEXT IMAGE VIDEO AUDIO DOCUMENT STICKER LOCATION CONTACT
  text       String?  @db.LongText
  timestamp  DateTime @db.DateTime(3)
  quotedId   String?
  raw        String?  @db.LongText // WAMessage JSON, only for media (needed to download it later)
  mediaState String   @default("none") // none | pending | saved | skipped | unavailable | error
  mediaFile  String?  // path inside the chat folder, e.g. audios/<file>
  mediaMime  String?
  mediaSize  Int?
  mediaError String?  @db.Text

  chat ArchiveChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([sessionId, keyId])
  @@index([chatId, timestamp, id])
  @@index([sessionId, mediaState])
}

model AffiliateConversion {
  id           String   @id @default(cuid())
  sessionId    String
  platform     String   // shopee | mercadolivre
  originalUrl  String   @db.Text
  affiliateUrl String   @db.Text
  productId    String?
  tag          String?
  senderJid    String?
  status       String   @default("success") // success | error
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([platform, createdAt])
}

// --- SaaS Packaging & Multi-tenant Billing ---

model Plan {
  id                String   @id @default(cuid())
  slug              String   @unique // starter, pro, enterprise
  name              String
  description       String?
  priceCents        Int      @default(0)
  maxSessions       Int      @default(1)
  maxUsers          Int      @default(2)
  maxBroadcastDaily Int      @default(100)
  hasAiStudio       Boolean  @default(false)
  hasCrm            Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions     Subscription[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  planId           String
  status           String    @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELED, EXPIRED
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  externalRef      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
}

// --- B2B CRM, Sales Funnel & Tickets ---

model Pipeline {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@index([userId])
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  color      String   @default("#3B82F6")
  order      Int      @default(0)
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)

  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]

  @@index([pipelineId, order])
}

model Deal {
  id                String    @id @default(cuid())
  pipelineId        String
  stageId           String
  sessionId         String
  contactJid        String
  contactName       String?
  contactPhone      String?
  title             String
  valueCents        Int       @default(0)
  status            String    @default("OPEN") // OPEN, WON, LOST
  followUpAt        DateTime?
  followUpCount     Int       @default(0)
  lastInteractionAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  session           Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  notes             DealNote[]

  @@index([sessionId, contactJid])
  @@index([pipelineId, stageId])
}

model DealNote {
  id         String   @id @default(cuid())
  dealId     String
  authorName String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model ConversationTicket {
  id             String    @id @default(cuid())
  sessionId      String
  contactJid     String
  contactName    String?
  assignedUserId String?
  status         String    @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CUSTOMER, RESOLVED
  priority       String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  botPausedUntil DateTime?
  slaDueAt       DateTime?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([sessionId, contactJid])
  @@index([status, assignedUserId])
}

// --- Product Catalog & PIX Quick Send ---

model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  priceCents  Int      @default(0)
  pixKey      String?
  imageUrl    String?  @db.Text
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// --- Appointment Agenda & Reminders ---

model Appointment {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String
  contactJid      String
  contactName     String?
  title           String
  notes           String?  @db.Text
  scheduledAt     DateTime
  durationMin     Int      @default(60)
  status          String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELED, NO_SHOW
  reminder24hSent Boolean  @default(false)
  reminder2hSent  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, scheduledAt])
  @@index([userId, scheduledAt])
}

// --- Instagram Scheduling (Feed, Carousel, Reels & Stories) ---

enum InstagramPostType {
  FEED
  CAROUSEL
  REELS
  STORY
}

enum InstagramPostStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

model InstagramAccount {
  id                String   @id @default(cuid())
  userId            String
  igUserId          String
  username          String
  name              String?
  profilePictureUrl String?  @db.Text
  accountType       String?
  accessToken       String   @db.Text
  tokenExpiresAt    DateTime
  status            String   @default("CONNECTED") // CONNECTED, EXPIRED, ERROR
  lastError         String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts             InstagramPost[]

  @@unique([userId, igUserId])
  @@index([userId])
}

model InstagramPost {
  id            String              @id @default(cuid())
  userId        String
  accountId     String
  type          InstagramPostType   @default(FEED)
  caption       String?             @db.Text
  mediaItems    Json
  shareToFeed   Boolean             @default(true)
  scheduledAt   DateTime
  status        InstagramPostStatus @default(PENDING)
  igContainerId String?
  igMediaId     String?
  permalink     String?             @db.Text
  errorMessage  String?             @db.Text
  publishedAt   DateTime?
  retryCount    Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       InstagramAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([userId, scheduledAt])
  @@index([accountId, scheduledAt])
}

enum InstagramRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model InstagramAccessRequest {
  id           String                 @id @default(cuid())
  userId       String
  igUsername   String
  status       InstagramRequestStatus @default(PENDING)
  adminNote    String?                @db.Text
  approvedById String?
  approvedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}
